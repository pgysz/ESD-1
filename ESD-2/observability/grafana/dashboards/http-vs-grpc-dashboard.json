{
  "id": null,
  "uid": "attendance-http-vs-grpc",
  "title": "Attendance: HTTP vs gRPC (Assignment 2)",
  "tags": [
    "attendance",
    "assignment2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health (1 = up)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "up{job=~\"attendance-app|attendance-grpc\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Check-in calls by status: HTTP (POST /api/v1/attendance)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total{endpoint=\"/api/v1/attendance\",method=\"POST\"}[5m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Rate of HTTP check-in requests by status code, 5m window."
    },
    {
      "id": 3,
      "title": "Check-in calls by status: gRPC (CheckIn)",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "sum by (grpc_code) (rate(grpc_server_handled_total{grpc_method=\"CheckIn\"}[5m]))",
          "legendFormat": "gRPC {{grpc_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Rate of gRPC CheckIn calls by status code, 5m window."
    },
    {
      "id": 4,
      "title": "Error rate % (non-2xx HTTP vs non-OK gRPC)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{endpoint=\"/api/v1/attendance\",method=\"POST\",status_code!~\"2..\"}[5m])) / sum(rate(http_requests_total{endpoint=\"/api/v1/attendance\",method=\"POST\"}[5m]))",
          "legendFormat": "HTTP",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(grpc_server_handled_total{grpc_method=\"CheckIn\",grpc_code!=\"OK\"}[5m])) / sum(rate(grpc_server_handled_total{grpc_method=\"CheckIn\"}[5m]))",
          "legendFormat": "gRPC",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "Share of calls that did not succeed. Includes client errors (404/409/400 and their gRPC equivalents)."
    },
    {
      "id": 5,
      "title": "Duration p50 / p95 (server-side, 5m window)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint=\"/api/v1/attendance\",method=\"POST\"}[5m])))",
          "legendFormat": "HTTP p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint=\"/api/v1/attendance\",method=\"POST\"}[5m])))",
          "legendFormat": "HTTP p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(grpc_server_handling_seconds_bucket{grpc_method=\"CheckIn\"}[5m])))",
          "legendFormat": "gRPC p50",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_server_handling_seconds_bucket{grpc_method=\"CheckIn\"}[5m])))",
          "legendFormat": "gRPC p95",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Measured at the SERVER (HTTP: Flask after_request hook; gRPC: server interceptor). Percentiles are interpolated from histogram buckets."
    },
    {
      "id": 6,
      "title": "Average message size, bytes (JSON vs protobuf)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "sum by (direction) (rate(http_message_size_bytes_sum{endpoint=\"/api/v1/attendance\"}[5m])) / sum by (direction) (rate(http_message_size_bytes_count{endpoint=\"/api/v1/attendance\"}[5m]))",
          "legendFormat": "HTTP {{direction}}",
          "refId": "A"
        },
        {
          "expr": "sum by (direction) (rate(grpc_server_message_size_bytes_sum{grpc_method=\"CheckIn\"}[5m])) / sum by (direction) (rate(grpc_server_message_size_bytes_count{grpc_method=\"CheckIn\"}[5m]))",
          "legendFormat": "gRPC {{direction}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Body size of the same operation: JSON over HTTP vs protobuf over gRPC. HTTP includes failed requests (small problem+json bodies) as well as successes."
    },
    {
      "id": 7,
      "title": "Rate-limited requests (429) per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(rate_limited_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "New metric: how often the signup rate limit is hit."
    },
    {
      "id": 8,
      "title": "Idempotent replays per second",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(idempotent_replays_total[5m]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "New metric: repeated requests answered from a stored result."
    },
    {
      "id": 9,
      "title": "Database operation p95 by operation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(store_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "New metric: latency of the shared SQLite store, from both processes."
    },
    {
      "id": 10,
      "title": "Currently checked in (from the database)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "targets": [
        {
          "expr": "max(currently_checked_in)",
          "legendFormat": "checked in",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}